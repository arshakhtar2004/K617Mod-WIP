<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>K617Mod.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin this once it's confirmed working against the real device -
         don't float on "latest" indefinitely, per the ViGEm.NET drift
         hurdle already flagged for a later module. -->
    <PackageReference Include="HidSharp" Version="2.1.0" />

    <!-- Official .NET client for the ViGEmBus driver. Version below is
         a best-effort pin, not verified against a live restore from this
         environment (no NuGet access here) - if `dotnet restore` can't
         find this exact version, open NuGet Package Manager, search
         "Nefarius.ViGEm.Client", and take whatever the latest stable
         release is instead. -->
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Mapping\Data\keymapping.default.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Content, not None, on purpose: Content flows through a
         ProjectReference into the referencing project's output folder,
         None does not. K617Mod.Ui needs this file next to its own exe. -->
    <Content Include="Mapping\Data\profile.default.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- Embedded as well as copied. The loose copy is what the console
         host and the harnesses read, and it stays the file to edit. The
         embedded one is what the published app reads, because a
         single-file publish has no folder beside the exe to look in -
         see DefaultProfileTemplate. Same source file embedded at build
         time, so the two cannot drift. -->
    <EmbeddedResource Include="Mapping\Data\profile.default.json" />
  </ItemGroup>

</Project>
