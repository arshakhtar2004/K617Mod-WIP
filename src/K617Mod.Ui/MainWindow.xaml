<Window x:Class="K617Mod.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:K617Mod.Ui"
        Title="K617 HE Racing Mod"
        Height="720" Width="1040"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- Built into WPF. Turns the nav item's IsChecked into
             Visible/Collapsed for the matching panel, so which panel
             shows is decided entirely in XAML - no code-behind. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- A nav item is really a RadioButton: picking one
             automatically unpicks the others, which is exactly the
             behaviour wanted, and it comes free. The template below
             just strips the little radio circle and makes it look like
             a sidebar row instead. -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2D2E" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#094771" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared look for each setting page's heading. -->
        <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="PlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Mod on/off switch. No native WPF "toggle switch" control, so
             this is a ToggleButton with its default chrome stripped and
             a pill-shaped template in its place: a rounded track that
             changes colour, with a circular knob that snaps to whichever
             side matches IsChecked. No slide animation for now - a
             ControlTemplate trigger alone can't smoothly move the knob
             without a Storyboard, and a snap reads clearly enough. -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                CornerRadius="12"
                                Background="#555555">
                            <Ellipse x:Name="Knob"
                                     Width="18" Height="18"
                                     Fill="#EFEFEF"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3FB950" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin here gives the gap on the left of the nav, and on the
         right of the content area. The gap between the two comes from
         the content Border's own left margin below. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- HEADER: mod on/off switch + live connection/suppression
             status. Spans both columns - this is app-wide state, not
             part of whichever settings page happens to be selected, so
             it sits above the nav/content split rather than inside it. -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Background="#252526"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="ModToggle"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Click="ModToggle_Click" />
                <TextBlock Text="Mod"
                           Foreground="#CCCCCC"
                           FontSize="14"
                           Margin="10,0,20,0"
                           VerticalAlignment="Center" />
                <Ellipse x:Name="StatusDot"
                         Width="10" Height="10"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Foreground="#CCCCCC"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- LEFT: setting selector -->
        <StackPanel Grid.Row="1" Grid.Column="0">
            <RadioButton x:Name="NavRemapKeys"
                         Content="Remap Keys"
                         GroupName="Settings"
                         IsChecked="True"
                         Style="{StaticResource NavItemStyle}" />
            <RadioButton x:Name="NavCurves"
                         Content="Response Curves"
                         GroupName="Settings"
                         Style="{StaticResource NavItemStyle}" />
            <RadioButton x:Name="NavC"
                         Content="C"
                         GroupName="Settings"
                         Style="{StaticResource NavItemStyle}" />
        </StackPanel>

        <!-- RIGHT: the canvas the selected setting draws into. Each
             page sits in the same cell and only one is visible at a
             time, driven by the nav selection. -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="#252526"
                CornerRadius="6"
                Margin="16,0,0,0"
                Padding="20">
            <Grid>
                <local:RemapPage Visibility="{Binding IsChecked, ElementName=NavRemapKeys, Converter={StaticResource BoolToVis}}" />

                <local:CurvePage Visibility="{Binding IsChecked, ElementName=NavCurves, Converter={StaticResource BoolToVis}}" />

                <StackPanel Visibility="{Binding IsChecked, ElementName=NavC, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="C" Style="{StaticResource PageHeadingStyle}" />
                    <TextBlock Style="{StaticResource PlaceholderStyle}"
                               Text="To be decided." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
