<Window x:Class="K617Mod.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K617 HE Racing Mod"
        Height="640" Width="960"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <!-- Empty canvas, on purpose. Features get added into this grid one
         at a time: ON/OFF + status, then profile selector, then key
         remap, then the curve editor. -->
    <Grid>
        <TextBlock Text="K617 HE Racing Mod"
                   Foreground="#DDDDDD"
                   FontSize="22"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Grid>
</Window>
