<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: stops a console window appearing behind the UI. -->
    <OutputType>WinExe</OutputType>

    <!-- net8.0-windows, not plain net8.0 - WPF is a Windows-only
         framework and won't load without the platform suffix. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <!-- WPF has no tray icon of its own. WinForms' NotifyIcon is the
         built-in one, and turning this on costs a build flag rather than a
         third-party package - which matters for a project someone else is
         meant to clone and build without surprises. Both flags together in
         one project is supported on .NET 8; the cost is that
         System.Windows.Forms types need qualifying where their names clash
         with WPF's (Application, MessageBox), which TrayIcon.cs does. -->
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>K617Mod.Ui</RootNamespace>

    <!-- Elevation. See app.manifest for why this asks for administrator
         rather than running as invoker. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- DPI awareness lives here, not in app.manifest. UseWindowsForms
         generates its own manifest fragment for this, and declaring it
         a second time in app.manifest made `dotnet publish` fail with
         MSB3094 (two manifest sources, one destination slot) - the
         WFAC010 warning printed just before that error names this exact
         property as the fix. This is a process-wide Win32 setting, so it
         covers the WPF windows as well as WinForms' tray icon, not just
         the control that happens to be WinForms. PerMonitorV2 specifically
         because the curve editor draws to exact pixel coordinates and
         would otherwise get bitmap-stretched on a scaled display. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- The name on the thing a person double-clicks. Without this the
         output is K617Mod.Ui.exe, which reads like an internal build
         artefact rather than an application. -->
    <AssemblyName>K617Mod</AssemblyName>
    <Product>K617 HE Racing Mod</Product>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <!-- Publish settings deliberately live in publish.cmd rather than
         here, so an ordinary `dotnet build` is not slowed down by them
         and nothing depends on guessing which MSBuild property means
         "we are publishing right now". -->
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms would otherwise add System.Drawing and
         System.Windows.Forms as GLOBAL implicit usings, which breaks
         existing files rather than helping: CurveEditor.xaml.cs already
         imports System.Windows.Media and uses Point and Color unqualified,
         and both names exist in System.Drawing too - so every one of those
         references becomes ambiguous the moment WinForms is switched on.
         Removing them keeps WinForms opt-in per file, which is what
         TrayIcon.cs does with its own alias. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wired in now that the empty window is confirmed building. The
         remap page reads the default profile through Core's own
         ProfileDocument type rather than re-declaring the JSON shape
         here - one definition of the format, not two. -->
    <ProjectReference Include="..\K617Mod.Core\K617Mod.Core.csproj" />
  </ItemGroup>

</Project>
