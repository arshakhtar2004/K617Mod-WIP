<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: stops a console window appearing behind the UI. -->
    <OutputType>WinExe</OutputType>

    <!-- net8.0-windows, not plain net8.0 - WPF is a Windows-only
         framework and won't load without the platform suffix. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>K617Mod.Ui</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wired in now that the empty window is confirmed building. The
         remap page reads the default profile through Core's own
         ProfileDocument type rather than re-declaring the JSON shape
         here - one definition of the format, not two. -->
    <ProjectReference Include="..\K617Mod.Core\K617Mod.Core.csproj" />
  </ItemGroup>

</Project>
