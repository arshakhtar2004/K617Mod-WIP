<Application x:Class="K617Mod.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- No StartupUri: launching opens no window at all, only a tray icon.
         OnExplicitShutdown goes with it - the default shutdown mode ends
         the process when the last window closes, which for a tray app that
         may have no window open would mean quitting the moment the config
         window is dismissed. -->
    <Application.Resources>
    </Application.Resources>
</Application>
