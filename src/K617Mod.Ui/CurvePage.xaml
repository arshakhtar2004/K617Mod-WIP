<UserControl x:Class="K617Mod.Ui.CurvePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:K617Mod.Ui">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#0E639C" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1177BB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#2E3238" />
                                <Setter Property="Foreground" Value="#7A8089" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <!-- Axis list rows -->
        <Style x:Key="AxisItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D2E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Response Curves" Foreground="#FFFFFF" FontSize="20" Margin="0,0,0,4" />
            <TextBlock Text="How far a key is pressed, turned into how much the controller reports. Drag a point to reshape it, double-click the graph to add one, right-click a point to remove it."
                       Foreground="#8A8A8A" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Profile" Foreground="#9DA5B4" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="150"
                          ItemsSource="{Binding ProfileNames}"
                          SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}" />

                <TextBlock Text="{Binding StatusNote}" Foreground="#8A8A8A" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0" />

                <Button Content="Apply" Style="{StaticResource ActionButtonStyle}"
                        IsEnabled="{Binding HasUnsavedChanges}" Click="Apply_Click" />
                <Button Content="Revert" Style="{StaticResource ActionButtonStyle}"
                        IsEnabled="{Binding HasUnsavedChanges}" Click="Revert_Click" />
            </StackPanel>

            <TextBlock Text="{Binding LoadError}" Foreground="#E06C75" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoadError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Which axis is being edited -->
            <ListBox x:Name="AxisList"
                     Grid.Column="0"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource AxisItemStyle}"
                     SelectionChanged="AxisList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock x:Name="AxisDescription"
                           Foreground="#8A8A8A" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,8" />

                <local:CurveEditor x:Name="Editor" CurveChanged="Editor_CurveChanged" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Linear" Style="{StaticResource PresetButtonStyle}"
                            IsEnabled="{Binding IsEditable}" Click="PresetLinear_Click" />
                    <Button Content="Soft (squared)" Style="{StaticResource PresetButtonStyle}"
                            IsEnabled="{Binding IsEditable}" Click="PresetSoft_Click" />
                    <Button Content="Sharp" Style="{StaticResource PresetButtonStyle}"
                            IsEnabled="{Binding IsEditable}" Click="PresetSharp_Click" />
                    <Button Content="Deadzone 15%" Style="{StaticResource PresetButtonStyle}"
                            IsEnabled="{Binding IsEditable}" Click="PresetDeadzone_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
